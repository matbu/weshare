# Copy to .env and fill in (scripts/init.sh generates it for you).

POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
JWT_SECRET=change-me-too

# Public domain served by Caddy (automatic HTTPS). Leave ":80" for plain HTTP / local tests
# or when another reverse proxy (Apache, Traefik) terminates TLS.
DOMAIN=:80

# Persistent data (Postgres + Caddy certificates)
DATA_DIR=/data/webcams

# Published ports. Standalone VPS: 80 / 443.
# Behind an existing reverse proxy: bind to localhost, e.g. 127.0.0.1:8210
HTTP_PUBLISH=80
HTTPS_PUBLISH=443
PG_PUBLISH=127.0.0.1:5432

# Identify the bot honestly with a REAL contact: this is what keeps you from being banned.
# Placeholders (example.com) and library defaults (python-httpx) get HTTP 406 from Overpass.
BOT_USER_AGENT=WorldWebcamsBot/1.0 (+https://your-site.tld/bot)

# Optional: enables the Windy collector (https://api.windy.com/keys)
WINDY_API_KEY=

CORS_ORIGINS=*
LOG_LEVEL=INFO
API_WORKERS=2

# Postgres memory (about 25% / 50-75% of the RAM you give to this stack)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
